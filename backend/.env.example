# Conexión a la base de datos.
# PostgreSQL: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
# Desarrollo sin PostgreSQL: sqlite:///./foodstore.db
DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/foodstore_db

# Firma de los JWT: mínimo 32 caracteres. Cambiala en tu .env.
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido por CORS (con credenciales).
FRONTEND_ORIGIN=http://localhost:5173
